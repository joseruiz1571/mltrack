[0.000, "o", "                            \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1m  Production        \u001b[0m\u001b[1m  \u001b[0m│  \u001b[31m2\u001b[0m  │                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1m  Staging           \u001b[0m\u001b[1m  \u001b[0m│  \u001b[33m1\u001b[0m  │                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1m  Development       \u001b[0m\u001b[1m  \u001b[0m│  \u001b[32m2\u001b[0m  │                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1m                    \u001b[0m\u001b[1m  \u001b[0m│     │                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1;36mCompliance\u001b[0m\u001b[1m          \u001b[0m\u001b[1m  \u001b[0m│     │                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1m  Compliant         \u001b[0m\u001b[1m  \u001b[0m│  \u001b[32m5\u001b[0m  │                                        "]
