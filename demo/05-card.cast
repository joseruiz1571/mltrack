[0.016, "o", "\u001b[32m╭─\u001b[0m\u001b[32m────────────────────────────────────────\u001b[0m\u001b[32m \u001b[0m\u001b[32m✓ Sample Data Generated\u001b[0m\u001b[32m \u001b[0m\u001b[32m─────────────────────────────────────────\u001b[0m\u001b[32m─╮\u001b[0m\r\n\u001b[32m│\u001b[0m ╭────────────────────────┬─────╮                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1mModels Created      \u001b[0m\u001b[1m  \u001b[0m│  \u001b[32m5\u001b[0m  │                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1m                    \u001b[0m\u001b[1m  \u001b[0m│     │                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m │\u001b[1m  \u001b[0m\u001b[1;36mRisk Distribution\u001b[0m\u001b[1m   \u001b[0m\u001b[1m  \u001b[0m│     │                                                        "]
