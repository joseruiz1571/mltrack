[0.012, "o", "                                                                                       \r\n \u001b[1;2m \u001b[0m\u001b[1;2mModel            \u001b[0m\u001b[1;2m \u001b[0m \u001b[1;2m \u001b[0m\u001b[1;2mVendor   \u001b[0m\u001b[1;2m \u001b[0m \u001b[1;2m \u001b[0m\u001b[1;2m  Risk  \u001b[0m\u001b[1;2m \u001b[0m \u001b[1;2m \u001b[0m\u001b[1;2mUse Case                                \u001b[0m\u001b[1;2m \u001b[0m \r\n ───────────────────────────────────────────────────────────────────────────────────── \r\n \u001b[36m \u001b[0m\u001b[36mcredit-risk-model\u001b[0m\u001b[36m \u001b[0m  In-house      \u001b[31mHIGH\u001b[0m     Loan underwriting risk assessment         \r\n \u001b[36m \u001b[0m\u001b[36mbedrock-titan    \u001b[0m\u001b[36m \u001b[0m  AWS           \u001b[31mHIGH\u001b[0m     KYC document verification and extraction  \r\n \u001b[36m \u001b[0m\u001b[36mcomprehend-pii   \u001b[0m\u001b[36m \u001b[0m  AWS           \u001b[31mHIGH\u001b[0m     Anti-money laundering transaction         \r\n \u001b[36m                   \u001b[0m                         monito...                             "]
