[0.272, "o", "\r\n"]
[1.630, "o", "\u001b[1;33m# Register the model we care about.\u001b[0m\r\n"]
[1.119, "o", "\u001b[1;36m❯\u001b[0m \u001b[1mmltrack add --name fraud-detector --vendor In-house --risk-tier critical --use-case 'Real-time fraud detection for wire transfers' --business-owner 'Risk Management' --technical-owner 'ML Platform' --deployment-date 2026-02-01 --environment prod --data-classification confidential --version 2.3.0\u001b[0m\r\n"]
[1.793, "o", "\r\n"]
[0.005, "o", "\u001b[32m╭─\u001b[0m\u001b[32m───────────────────────────────────────\u001b[0m\u001b[32m \u001b[0m\u001b[32m✓ Model Added Successfully\u001b[0m\u001b[32m \u001b[0m\u001b[32m───────────────────────────────────────\u001b[0m\u001b[32m─╮\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mID             \u001b[0m\u001b[1m  \u001b[0m  \u001b[2mfacffdb1-a34c-4617-bb0b-82d55b456f0a\u001b[0m                                                  \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mName           \u001b[0m\u001b[1m  \u001b[0m  \u001b[36mfraud-detector\u001b[0m                                                                        \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mVendor         \u001b[0m\u001b[1m  \u001b[0m  In-house                                                                              \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mRisk Tier      \u001b[0m\u001b[1m  \u001b[0m  \u001b[1;31mCRITICAL\u001b[0m                                                                              \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m"]
[0.000, "o", "\u001b[1mBusiness Owner \u001b[0m\u001b[1m  \u001b[0m  Risk Management                                                                       \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mTechnical Owner\u001b[0m\u001b[1m  \u001b[0m  ML Platform                                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mDeployed       \u001b[0m\u001b[1m  \u001b[0m  2026-02-01                                                                            \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mNext Review    \u001b[0m\u001b[1m  \u001b[0m  \u001b[33m2026-03-03\u001b[0m (30 days)                                                                  \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mVersion        \u001b[0m\u001b[1m  \u001b[0m  2.3.0                                                                                 \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[1m  \u001b[0m\u001b[1mEnvironment    \u001b[0m\u001b[1m  \u001b[0m  PROD                                                                                  \u001b[32m│\u001b[0m\r\n\u001b[32m╰─\u001b[0m\u001b[32m───────────────────────"]
[0.000, "o", "────\u001b[0m\u001b[32m \u001b[0m\u001b[2;32mUse 'mltrack show fraud-detector' for full details\u001b[0m\u001b[32m \u001b[0m\u001b[32m───────────────────────────\u001b[0m\u001b[32m─╯\u001b[0m\r\n"]
[0.093, "o", "\r\n"]
[1.603, "o", "\u001b[1;33m# An inventory row IS governance data. Make that literal: export a Model Card.\u001b[0m\r\n"]
[1.109, "o", "\u001b[1;36m❯\u001b[0m \u001b[1mmltrack card export fraud-detector -o fraud-detector.card.json\u001b[0m\r\n"]
[1.321, "o", "\u001b[32m╭─\u001b[0m\u001b[32m \u001b[0m\u001b[1;32mCard Exported\u001b[0m\u001b[32m \u001b[0m\u001b[32m───────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[32m─╮\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[32m✓\u001b[0m Model Card written to \u001b[36mfraud-detector.card.json\u001b[0m                                                           \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[2mcard_type=model  spec_version=0.1.0  uuid=facffdb1-a34c-4617-bb0b-82d55b456f0a\u001b[0m                             \u001b[32m│\u001b[0m\r\n\u001b[32m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.120, "o", "\r\n"]
[1.607, "o", "\u001b[1;33m# A portable, structured governance artifact:\u001b[0m\r\n"]
[1.104, "o", "\u001b[1;36m❯\u001b[0m \u001b[1mjq '{card_type, name: .metadata.name, uuid: .metadata.uuid, lifecycle: .metadata.lifecycle_status, provider: .model.provider, risk: .classification.risk_tier}' fraud-detector.card.json\u001b[0m\r\n"]
[0.717, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"card_type\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"model\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"fraud-detector\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"uuid\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"facffdb1-a34c-4617-bb0b-82d55b456f0a\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"lifecycle\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"active\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"provider\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"In-house\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"risk\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"critical\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n"]
[1.607, "o", "\u001b[1;33m# Validate it against the Governance Card Stack schema — a CI-ready gate.\u001b[0m\r\n"]
[1.106, "o", "\u001b[1;36m❯\u001b[0m \u001b[1mmltrack card validate fraud-detector.card.json\u001b[0m\r\n"]
[1.367, "o", "\u001b[32m╭─\u001b[0m\u001b[32m \u001b[0m\u001b[1;32mValid\u001b[0m\u001b[32m \u001b[0m\u001b[32m───────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[32m─╮\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[32m✓\u001b[0m \u001b[1mfraud-detector.card.json\u001b[0m is a valid Governance Model Card                                                \u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m \u001b[2mcard_type=model  spec_version=0.1.0\u001b[0m                                                                        \u001b[32m│\u001b[0m\r\n\u001b[32m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.105, "o", "\r\n"]
[1.604, "o", "\u001b[1;33m# Inventory becomes interoperable governance data. That is the bridge.\u001b[0m\r\n"]
[2.123, "x", "0"]
